; PDU default parameter file: every setting at its built-in default.
; Generated by `python -m pdukit.config.reference --write`; do not
; edit by hand.  Copy it, delete the lines you do not change and use it with
; `pdu run -p my.ppf ...`.  Precedence: command line, then this file, then
; the built-in default.  Settings that describe a run rather than the
; science (files, output folder, device) are not listed.  The full text of
; each setting is in docs/OPTIONS.md.

; ---- files and general options ----

; random seed
seed = 0

; progress log detail: quiet = warnings only, info = one line per step,
; debug = also per-growth-step traces [quiet, info, debug]
log-level = info

; ---- MD data ----

; first N frames per replica (0 = all)
frames = 0

; use every Nth frame of each replica
stride = 1

; radius in angstrom of a residue's structural environment: neighbours
; inside it enter its descriptor
rse-cutoff = 15.0

; slow tICA components kept per residue after compressing its neighbour
; distances: a number >= 1, or -1 = choose it from rse-coverage (two passes
; over the distances)
rse-components = -1

; with rse-components = -1: smallest number of tICA modes at which the
; median residue keeps this share of its kinetic variance (sum of lambda^2
; over its whole spectrum); always reported in results
; tica_spectrum.coverage
rse-coverage = 0.9

; with rse-components = -1: upper limit on the chosen number of tICA modes
; (0 = none); memory is frames x residues x modes x 4 bytes per feature set
rse-max-components = 0

; neighbours closer than this in sequence are left out of the descriptor
; (trivially rigid)
min-seq-sep = 2

; angstrom cutoff of the residue contact graph (growth only follows
; contacts)
contact-cutoff = 8.0

; add pair-owned contact-distance features (Stage 4)
pair-features = 0

; (pair features) angstrom cutoff for pair contacts
pair-cutoff = 8.0

; ---- estimator ----

; lag in frames between the two time points whose coupling is measured (one
; frame = frame-ps)
lag = 1

; slow coordinates kept to describe each unit
unit-dim = 8

; slow coordinates kept to describe the environment (the rest of the
; protein)
env-dim = 20

; regularisation added to the covariance matrices before they are inverted
ridge = 0.01

; time shifts used to build the null distribution of the canonical
; correlations
n-null = 64

; how the null displaces the environment in time: global (pooled), within
; (each replica), cross (a different replica); auto = cross with 2+
; replicas, else within [auto, global, within, cross]
shift-mode = auto

; estimator backend: flux (FluxWorkspace) or schur (Schur- complement form)
; [flux, schur]
backend = flux

; how incoming and outgoing channels form the cost: max, sum, in (incoming
; only) or out (outgoing only) [max, sum, in, out]
combine = max

; unit's present subtracted whole (COG 2.1) or as unit_dim slow modes (v1.0)
; [full, reduced]
cond-unit = full

; environment's present subtracted whole ('full'), as N slow modes (an
; integer), or as env_dim modes ('reduced', v1.0)
cond-env = full

; ---- calibration ----

; calibration sizes, e.g. '2-40' (default 2..max-unit)
;sizes =

; (calibration) stop adding supports once the bootstrap interval of a
; threshold is this fraction of its value
target-rel-width = 0.03

; (calibration) fewest random supports scored per size
min-supports = 40

; (calibration) most random supports scored per size
max-supports = 300

; calibration supports scored per batch
batch-supports = 32

; stop after the calibration (to check thetas, the baseline and the time
; before a full run)
calibrate-only = 0

; ---- discovery ----

; comma list of replica indices (0-based)
;discovery-replicas =

; comma list, or 'none' to discover on everything
;holdout-replicas =

; hold out the last N replicas (0 = discover on all); alternative to the two
; lists above
;n-holdout =

; keep each replica's mean (v1.0 behaviour); by default every replica is
; centred on its own mean
no-center-replicas = 0

; apply --highpass-window to the raw neighbour distances BEFORE each
; residue's slow directions are chosen (MD data)
highpass-before-features = 0

; remove overall rotation and translation (Kabsch) before building features
fit = 0

; calibrate only ~N sizes spread over the range and interpolate the rest (0
; = every size)
calibrate-coarse = 0

; drop the first N frames of every replica
skip-frames = 0

; remove a running mean of this many frames within every replica (0 = off;
; 'auto' = the smallest window whose null threshold is within --null-cal-tol
; of the lowest in the null calibration scan)
highpass-window = 0

; skip the highpass-window scan before discovery
no-null-calibration = 0

; comma list of windows (frames) to scan; 'auto' = geometric from 10 x lag
; to a replica / 8
null-cal-windows = auto

; (highpass-window scan) number of windows tried
null-cal-n-windows = 6

; (highpass-window scan) comma list of support sizes used
null-cal-sizes = 3,10

; (highpass-window scan) random supports per size
null-cal-supports = 48

; (highpass-window scan) time shifts per null
null-cal-n-null = 32

; largest acceptable null threshold (theta_in and theta_out); a warning is
; printed if no window reaches it
null-cal-target = 0.06

; 'random' = N residues drawn at random (dynamics only); 'spread' =
; farthest-point on the graph [random, spread]
seeding = random

; graph used everywhere a neighbourhood is needed (growth, round 2, and the
; random comparison regions of the baseline/null): 'predictive' = residues
; whose present predicts another's future beyond a shift null (dynamics
; only); 'contact' = spatial contacts (old behaviour); 'union' = both
; [predictive, contact, union]
search-graph = predictive

; comparison regions for the cost baseline: 'graph' = random connected sets
; on the search graph; 'random' = uniformly random residue sets; 'contact' =
; compact spatial balls (old) [graph, random, contact]
baseline = graph

; strongest predictive partners kept per residue
graph-k = 5

; time shifts used for the null of the predictive graph
graph-null-shifts = 16

; minimum channel strength: a channel counts only if its correlation exceeds
; max(noise threshold, this) (effect-size floor; 0 = off)
rho-min = 0.0

; block length in us (MD data)
block-us = 1.0

; block length in frames (planted data; 0 = auto)
block-frames = 0

; cores and faces: residues that carry a second unit's motion become faces
; (attached to both units); cores are scored with faces removed from both
; sides
faces = 0

; do not record the per-residue ledger
no-ledger = 0

; second round for residues in groups with cost > 0: grow new units inside
; that pool, then let pool residues join a unit only if its cost improves;
; the rest get a secondary (best-place) assignment
resolve = 0

; after round 2: steepest descent over one-residue changes for every unit,
; then n random kicks; reports whether each unit is a stable minimum
; (cog2_stability)
stability = 0

; incoming (default): strictly decrease nu_in at every addition; no J or
; outgoing penalty; save growth paths and apply the selected incoming-
; postprocess mode. channels and cohesion are the archived COG 2.1 modes
; (git tag archive/pre-incoming-only) and are refused by pdu run [cohesion,
; channels, incoming]
grow-objective = incoming

; incoming growth: require nu_in to decrease by more than this value
; (default strictly decreasing; 1e-12 numerical tolerance)
incoming-min-gain = 0.0

; incoming growth: the FIRST addition to a start must lower nu_in by more
; than this (later additions use incoming-min-gain); stops starts that only
; grow on noise. 0 = off
start-min-gain = 0.0

; JSON file of zero-based starting residue lists; otherwise use the
; configured single-residue seeds
;incoming-starts =

; incoming growth: recursive cohesion splitting (default); none is growth
; only (the older mc and merge-mc refinement is archived) [none, split]
incoming-postprocess = split

; within-parent cut proposal after incoming-only growth [recursive-spectral,
; directed-modularity, markov-stability]
split-method = recursive-spectral

; graph diffusion time, separate from the MD lag
split-markov-time = 16.0

; graph-exchangeability null and/or selected-cut block bootstrap [both,
; graph-null, bootstrap, none]
split-test = both

; reciprocal-dyad graph nulls; repeat cut search for each
split-null = 199

; (recursive split) significance level of the cohesion test (halved at each
; depth)
split-alpha = 0.05

; (recursive split) how many times a unit may be split in turn
split-max-depth = 8

; ports: a left-out residue joins the unit it prefers both ways if neither
; the step change in cohesion nor the change against the core exceeds this
; many bootstrap standard deviations (guarded rounds)
port-z = 1.645

; units given to global-mode recovery after splitting: core + ports
; (extended) or cores only [extended, core]
mode-units = extended

; JSON file of fixed residue sets (zero-based); score their
; incoming/outgoing channels and cohesion instead of searching. Sets with
; mode_unit true are used for global-mode recovery
;score-sets =

; incoming split path: before splitting, group grown supports (best nu_in
; first) into families when they share at least this fraction of the smaller
; of the support and the family's majority core; parent = union if its nu_in
; is not higher than the best member's, else the best member; the split then
; re-tests each parent
merge-overlap = 0.5

; bootstrap resamples for the cohesion noise margin
cohesion-boot = 20

; at least this many blocks (whole replicas if there are enough, else
; replicas split in contiguous blocks)
cohesion-blocks = 20

; 'auto' window = the smallest window whose null threshold is within this
; fraction of the lowest one in the scan
null-cal-tol = 0.15

; scan on at most this many replicas (evenly spaced)
null-cal-max-replicas = 20

; time per frame in ps, for the logs only
frame-ps = 0.0

; score candidates in batches on the GPU engine (auto: when the workspace is
; on CUDA) [auto, on, off]
batched = auto

; 'ritz' = environment slow basis from the global slow modes + block inverse
; (faster, approximate) [exact, ritz]
env-basis = exact

; do not read or write the feature cache
no-feature-cache = 0

; skip the tICA check of whether replicas visit the same states
no-replica-overlap = 0

; (decomposition) number of seed residues
dec-seeds = 24

; cap the number of seeds at this fraction of the residues (e.g. 0.25), so
; detection relies on growth, not on splitting overlaps; 0 = no cap (dec-
; seeds only)
seed-fraction = 0.0

; residues in each growth start: 1 = the seed alone (default); N = the seed
; plus its N-1 strongest predictive partners; 0 = just enough residues to
; fill unit-dim (ceil(unit-dim / features per residue)), so the first growth
; step compares sets with the same number of coordinates
seed-group = 1

; (decomposition) largest candidate grown from one seed (residues)
max-size = 16

; (decomposition) smallest unit kept (residues)
min-size = 3

; (decomposition) largest unit after merging (residues); also the top
; calibration size
max-unit = 40

; ratio: a residue new to a unit may join (merge, reassignment, round-2
; joins, MC) only if it predicts the unit's members more than the rest of
; the protein; none = old behaviour [ratio, none]
add-gate = ratio

; matched control sets (random, contiguous, ball) scored per unit size
n-controls = 8

; ---- verification ----

; comma list of lags (frames) at which the units are re-scored; 'none' skips
; this
verify-lags = 1,5,25

; time shifts used for the verification null
verify-null = 32

; ---- global-mode recovery ----

; at the end, assemble the local unit dynamics into global modes (on or off)
; [on, off]
mode-recovery = on

; (global-mode recovery) number of reference global slow modes
recovery-modes = 10

; local slow coordinates per PDU; 0 uses unit-dim
recovery-local-dim = 0

; incoming-rank ablation budgets; off and full on are automatic
recovery-channel-ranks = 1,2,4

; auto: exhaustive up to 8 PDUs; otherwise singles, pairs, leave-one-out and
; all [auto, all, singles-pairs]
recovery-combinations = auto

; (global-mode recovery) most unit combinations tried
recovery-max-combinations = 256

; optional JSON list of combinations of zero-based final PDU IDs
;recovery-subsets =
