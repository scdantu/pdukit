; T4L modes scan, tau 500 ps, ~50 us per protein (WT GA, L99A): rse-components = 16. Generated 2026-11-25.
; Same as tau_scan_50us/t4l_tau0500ps.ppf (dec-seeds 32, cohesion-boot 100) except rse-components.
; Kinetic-variance coverage of K modes at 500 ps (of the first 24, median over residues, 8855306): K2 0.26, K4 0.46, K8 0.69, K12 0.82, K16 0.91.
; Incoming-only growth. Same distance features, lag and filtering as prior runs.
; Incoming-only growth, recursive within-parent cohesion splitting, global-mode recovery.
seed = 0
frames         = 0
stride         = 1
rse-cutoff     = 15.0
rse-components = 16  ; tICA modes kept per residue (scan 2-16)
min-seq-sep    = 2
contact-cutoff = 8.0
pair-features  = 0
pair-cutoff    = 8.0
lag        = 25  ; tau = 25 frames x 20 ps
unit-dim   = 8
env-dim    = 20
ridge      = 0.01
n-null     = 128
shift-mode = auto
backend    = flux
combine    = max
cond-unit  = full
cond-env   = full
sizes            = 2-120
target-rel-width = 0.03
min-supports     = 40
max-supports     = 300
batch-supports   = 32
calibrate-only   = 0
n-holdout                = 0
no-center-replicas       = 0
highpass-before-features = 1
fit                      = 1
calibrate-coarse         = 8
skip-frames              = 0
highpass-window          = 500  ; 20 x lag, as in the Oct tau scan
no-null-calibration      = 1
null-cal-windows         = auto
null-cal-n-windows       = 6
null-cal-sizes           = 3,10
null-cal-supports        = 48
null-cal-n-null          = 32
null-cal-target          = 0.06
seeding                  = random
search-graph             = predictive
baseline                 = graph
graph-k                  = 5
graph-null-shifts        = 16
rho-min                  = 0.0
block-us                 = 1.0
block-frames             = 0
faces                    = 0
no-ledger                = 0
resolve = 0
stability = 0
grow-objective = incoming
cohesion-boot            = 100  ; was 20; tighter port guard and direction calls
cohesion-blocks          = 20
null-cal-tol             = 0.15
null-cal-max-replicas    = 20
frame-ps                 = 20.0
batched                  = auto
env-basis                = exact
no-feature-cache         = 0
no-replica-overlap = 1
dec-seeds                = 32  ; <= 25% of residues (164): growth finds units, splitting does not have to
max-size                 = 120
min-size                 = 3
max-unit                 = 120
add-gate                 = ratio
n-controls               = 8
verify-lags  = none
verify-null  = 32
incoming-min-gain = 0

incoming-postprocess = split

split-method = recursive-spectral
split-markov-time = 16
split-test = both
split-null = 199
split-alpha = 0.05
split-max-depth = 8
merge-overlap = 0.5  ; family = overlap >= half with majority core; parent = union only if nu_in not worse than best member; split re-tests
mode-recovery = on
recovery-modes = 10
recovery-local-dim = 0
recovery-channel-ranks = 1,2,4
recovery-combinations = auto
recovery-max-combinations = 256
