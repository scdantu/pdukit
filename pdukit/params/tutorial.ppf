; Tutorial settings: small and fast (a few minutes on a laptop CPU) for the demo
; trajectories made by tools/make_demo_trajectories.py (40 residues, 1500 frames of 20 ps).
; Based on t4l_incoming.ppf; only the keys below differ.  For real proteins start from
; t4l_incoming.ppf or default.ppf instead (see docs/TUTORIAL.md).

; Incoming-only growth. Same distance features, lag and filtering as prior runs.
; Incoming-only growth, recursive within-parent cohesion splitting, global-mode recovery.
seed                    = 0
frames         = 0
stride         = 1
rse-cutoff     = 15.0
rse-components = 8
min-seq-sep    = 2
contact-cutoff = 8.0
pair-features  = 0
pair-cutoff    = 8.0
lag                     = 10
unit-dim   = 8
env-dim    = 20
ridge      = 0.01
n-null                  = 32
shift-mode = auto
backend    = flux
combine    = max
cond-unit  = full
cond-env   = full
sizes                   = 2-20
target-rel-width = 0.03
min-supports            = 20
max-supports            = 80
batch-supports   = 32
calibrate-only   = 0
n-holdout                = 0
no-center-replicas       = 0
highpass-before-features = 1
fit                      = 1
calibrate-coarse        = 4
skip-frames              = 0
highpass-window         = 300
no-null-calibration      = 1
null-cal-windows         = auto
null-cal-n-windows       = 6
null-cal-sizes           = 3,10
null-cal-supports        = 48
null-cal-n-null          = 32
null-cal-target          = 0.06
seeding                  = random
search-graph             = predictive
baseline                 = graph
graph-k                  = 5
graph-null-shifts        = 16
rho-min                  = 0.0
block-us                 = 1.0
block-frames             = 0
faces                    = 0
no-ledger                = 0
resolve = 0
stability = 0
grow-objective = incoming
cohesion-boot            = 20
cohesion-blocks          = 20
null-cal-tol             = 0.15
null-cal-max-replicas    = 20
frame-ps                = 20
batched                  = auto
env-basis                = exact
no-feature-cache         = 0
no-replica-overlap = 1
dec-seeds               = 16
max-size                = 16
min-size                = 3
max-unit                = 16
add-gate                 = ratio
n-controls               = 8
verify-lags  = none
verify-null  = 32
incoming-min-gain = 0

incoming-postprocess = split

split-method = recursive-spectral
split-markov-time = 16
split-test = both
split-null = 199
split-alpha = 0.05
split-max-depth = 8
merge-overlap = 0.5  ; family = overlap >= half with majority core; parent = union only if nu_in not worse than best member; split re-tests
mode-recovery = on
recovery-modes = 10
recovery-local-dim = 0
recovery-channel-ranks = 1,2,4
recovery-combinations = auto
recovery-max-combinations = 256
